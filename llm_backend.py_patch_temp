def _deobfuscate(text):
    if not text: return ""
    try:
        import base64
        key = "STARFIELD"
        decoded = base64.b64decode(text).decode("utf-8")
        deobfuscated = "".join(chr(ord(c) ^ ord(key[i % len(key)])) for i, c in enumerate(decoded))
        return deobfuscated
    except:
        return text

